{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-executor",
  "version": "0.1.0",
  "description": "OpenCode plugin that exposes the Executor tool catalog natively in Code Mode",
  "type": "module",
  "license": "MIT",
  "author": "Saatvik Arya",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.43.0",
    "oxlint": "1.57.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "bun@1.4.3"
}
